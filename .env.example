[TEMPLATE]
# Admit IQ — API keys
#
# Local development: copy js/config.example.js to js/config.js and paste your
# Gemini keys there (js/config.js is gitignored, so they never reach GitHub).
#
# Vercel: set ONE environment variable in Project → Settings → Environment Variables:
#   GEMINI_API_KEYS = key1,key2,key3
# The build step injects them into js/config.js at deploy time (failover order
# = the order you list them).
GEMINI_API_KEYS=your_primary_gemini_key,your_backup_key_1,your_backup_key_2
